---
import siteConfig from '../site.config';

const nav = siteConfig.nav;
const current = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(href + '/');
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label="江恒律师首页">
      <span class="brand__name">江恒律师</span>
      <span class="brand__tag">跨境资金与出海合规</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav__checkbox" aria-hidden="true" />
    <label for="nav-toggle" class="nav__toggle nav__fallback">菜单</label>
    <button type="button" class="nav__toggle nav__button" aria-expanded="false" aria-controls="main-navigation" hidden>菜单</button>
    <nav id="main-navigation" class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={isActive(item.href) ? 'is-active' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .nav__toggle {
    display: none;
    font: inherit;
    font-size: 15px;
    min-width: 64px;
    min-height: 44px;
    touch-action: manipulation;
    border: 1px solid var(--line-strong);
    background: var(--white);
    color: var(--navy);
    border-radius: var(--radius);
    padding: 7px 14px;
    cursor: pointer;
  }
  .nav__checkbox { display: none; }
  @media (max-width: 720px) {
    .nav__toggle { display: inline-block; }
    .nav {
      display: none;
      width: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
      padding-top: 12px;
    }
    .nav__checkbox:checked ~ .nav { display: flex; }
    .site-header__inner { position: relative; }
  }
</style>

<script>
 const header = document.querySelector<HTMLElement>('.site-header');
 const menu = document.querySelector<HTMLButtonElement>('.nav__button');
 const toggle = document.querySelector<HTMLInputElement>('#nav-toggle');
 const fallback = document.querySelector<HTMLElement>('.nav__fallback');
 const navigation = document.querySelector<HTMLElement>('#main-navigation');
 if (header && menu && toggle && fallback && navigation) {
   menu.hidden = false;
   fallback.hidden = true;
   const syncHeaderHeight = () => {
     document.documentElement.style.setProperty('--header-height', `${header.getBoundingClientRect().height}px`);
   };
   const setOpen = (open: boolean) => {
     toggle.checked = open;
     menu.setAttribute('aria-expanded', String(open));
     menu.textContent = open ? '关闭菜单' : '菜单';
     syncHeaderHeight();
   };
   menu.addEventListener('click', () => setOpen(!toggle.checked));
   navigation.addEventListener('click', (event) => {
     if ((event.target as Element).closest('a')) setOpen(false);
   });
   document.addEventListener('keydown', (event) => {
     if (event.key === 'Escape' && toggle.checked) {
       setOpen(false);
       menu.focus();
     }
   });
   const mobile = window.matchMedia('(max-width: 720px)');
   mobile.addEventListener('change', () => setOpen(false));
   new ResizeObserver(syncHeaderHeight).observe(header);
   syncHeaderHeight();
 }
</script>
<style>.nav__toggle[hidden] { display: none !important; }</style>

