---
interface Props {
  title?: string;
  body?: string;
}
const {
  title = '需要咨询具体问题？',
  body = '如您正在处理跨境税务、出海合规、账户受限或境外架构相关问题，可联系江恒律师，先说明情况，再确认服务范围与沟通安排。',
} = Astro.props;
---

<section class="cta" aria-label="咨询入口">
  <h3>{title}</h3>
  <p>{body}</p>
  <a class="btn btn--ghost" href="/contact" style="background:#fff;color:var(--navy);">联系咨询</a>
</section>
