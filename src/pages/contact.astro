---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import siteConfig from '../site.config';

const a = siteConfig.author;
const d = siteConfig.display;
const hasEmail = Boolean(a.email);
const hasPhone = Boolean(a.phone);
---

<BaseLayout
  title="联系咨询"
  description="联系江恒律师做跨境税务、出海合规与跨境资金账户相关问题的初步评估。本站为静态站点，不提供在线表单，请通过已公开邮箱直接沟通，切勿发送保密材料。"
  canonicalPath="/contact"
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '联系咨询' }]} />
  </div>

  <section class="page-head">
    <div class="container">
      <p class="eyebrow">咨询入口</p>
      <h1>联系咨询</h1>
      <p class="lead">
        如您正在处理跨境税务、出海合规、账户受限或境外架构相关问题，
        可就具体问题联系江恒律师做初步评估。
      </p>
    </div>
  </section>

  <section class="section section--plain">
    <div class="container">
      {
        (hasEmail || hasPhone) && (
          <div class="navy-block" style="margin-bottom:32px;">
            <h2>公开联系方式</h2>
            <p>以下为已公开的正式联系渠道。请勿通过任何网页表单发送保密材料或敏感个人信息。</p>
            {hasEmail && (
              <p style="margin:0;">
                <a class="btn btn--light" href={`mailto:${a.email}?subject=跨境合规初步咨询`} style="font-size:16px;">
                  {a.email}
                </a>
              </p>
            )}
            {hasPhone && <p style="margin-top:10px;color:#cdd9e4;">电话：{a.phone}</p>}
            <p class="navy-block__note">
              提交咨询不构成委托关系，请勿发送保密材料或敏感信息（如账户号码、身份证件、合同条款）。
            </p>
          </div>
        )
      }

      <div class="card" style="max-width: 720px;">
        <div class="card__kicker">初步沟通</div>
        <h3>如何联系江恒律师</h3>
        <p>
          本站为静态站点，<strong>不提供在线表单提交</strong>。如您有跨境税务、出海合规、账户受限或境外架构相关问题，
          请直接通过已公开邮箱做初步沟通：
        </p>
        {
          hasEmail && (
            <p style="margin: 8px 0 0;">
              <a class="btn btn--primary" href={`mailto:${a.email}?subject=跨境合规初步咨询`}>
                {a.email}
              </a>
            </p>
          )
        }
        <p style="margin-top:16px;font-size:14px;color:var(--muted);line-height:1.8;">
          请在邮件中以概括性语言描述您的场景，避免包含可识别的保密信息（如账户号码、身份证件、合同条款）。
          初步沟通不构成委托关系或保密义务。
        </p>
      </div>

      <div class="disclaimer-box" role="note" style="margin-top:28px;">
        <strong>免责声明：</strong>
        本页内容仅为一般信息，不构成法律、税务、外汇、海关或投资意见，亦不构成委托代理关系。
        任何具体判断应结合事实与发布时有效规则，由具备资质的专业人士作出。
      </div>
    </div>
  </section>
</BaseLayout>
