---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import siteConfig from '../site.config';

const a = siteConfig.author;
const d = siteConfig.display;
const hasEmail = Boolean(a.email);
const hasPhone = Boolean(a.phone);
---

<BaseLayout
  title="联系咨询"
  description="联系江恒律师做跨境税务、出海合规与跨境资金账户相关问题的初步评估。本站为静态站点，不提供在线表单，请通过已公开邮箱直接沟通，切勿发送保密材料。"
  canonicalPath="/contact"
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '联系咨询' }]} />
  </div>

  <section class="contact-hero">
    <div class="container">
      <p class="eyebrow">咨询入口</p>
      <h1>联系咨询</h1>
      <p class="lead">
        如您正在处理跨境税务、出海合规、账户受限或境外架构相关问题，
        可就具体问题联系江恒律师做初步评估。
      </p>
    </div>
  </section>

  <section class="section section--plain contact-layout">
    <div class="container">
      {
        (hasEmail || hasPhone) && (
          <div class="navy-block contact-channel">
            <div><p class="navy-block__eyebrow">PUBLIC CHANNEL</p><h2>公开联系方式</h2>
            <p>以下为已公开的正式联系渠道。请勿通过任何网页表单发送保密材料或敏感个人信息。</p>
            </div>
            {hasEmail && (
              <div class="navy-block__action">
                <a class="btn btn--light" href={`mailto:${a.email}?subject=初步咨询｜请概括业务场景`} style="font-size:16px;">
                  发送咨询邮件 <span aria-hidden="true">→</span>
                </a>
                <p class="navy-block__action-meta">{a.email}</p>
              </div>
            )}
            {hasPhone && <p style="margin-top:10px;color:#cdd9e4;">电话：{a.phone}</p>}
            <p class="navy-block__note">
              提交咨询不构成委托关系，请勿发送保密材料或敏感信息（如账户号码、身份证件、合同条款）。
            </p>
          </div>
        )
      }

      <div class="contact-brief">
        <div>
          <p class="section-index">WHO THIS IS FOR</p>
          <h2>适合先做初步沟通的情形</h2>
          <ul class="clean-list">
            <li>正在处理跨境税务、供应链迁移、境外账户或跨境收款相关问题；</li>
            <li>已收到银行、客户、合作方或相关机构的问询、限制或材料要求；</li>
            <li>需要在作出申报、说明、资金安排或重大业务调整前，先厘清关键事实与风险边界。</li>
          </ul>
        </div>
        <div>
          <p class="section-index">A HELPFUL FIRST EMAIL</p>
          <h2>邮件中可简要说明三件事</h2>
          <ol class="contact-brief__steps">
            <li><span>01</span><p><strong>所涉业务</strong>：所属行业、涉及地区和当前业务背景。</p></li>
            <li><span>02</span><p><strong>核心问题</strong>：希望优先厘清的一个或两个具体问题。</p></li>
            <li><span>03</span><p><strong>时间节点</strong>：是否已有通知、回复期限或待作出的业务决策。</p></li>
          </ol>
        </div>
      </div>

      <div class="contact-guide">
        <div><span>01</span><h3>先用概括信息</h3><p>在确认沟通安排前，以非保密语言描述场景即可。</p></div>
        <div><span>02</span><h3>不要发送敏感材料</h3><p>请勿发送账户号码、身份证件、完整合同或未脱敏单证。</p></div>
        <div><span>03</span><h3>以正式约定为准</h3><p>初步沟通不构成委托关系或保密义务。</p></div>
      </div>

      <div class="disclaimer-box" role="note" style="margin-top:28px;">
        <strong>免责声明：</strong>
        本页内容仅为一般信息，不构成法律、税务、外汇、海关或投资意见，亦不构成委托代理关系。
        任何具体判断应结合事实与发布时有效规则，由具备资质的专业人士作出。
      </div>
    </div>
  </section>
</BaseLayout>
