---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { columnOf } from '../lib/columns';

const CATEGORY = '企业出海与原产地合规';
const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === CATEGORY)
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished));

function summaryOf(body: string): string {
  return body.match(/^>\s*摘要[：:]\s*(.+)$/m)?.[1]?.trim() ?? '';
}
const view = articles.map((a) => ({
  slug: a.slug,
  title: a.data.title,
  col: columnOf(a.data.category).label,
  updated: a.data.updatedAsOf,
  summary: summaryOf(a.body),
}));
---

<BaseLayout
  title="企业出海与原产地合规"
  description="江恒律师关于供应链迁移、东盟原产地认定、美国关税与贸易救济（Section 301/232、AD/CVD、反规避）合规风险的文章，基于美国官方来源并经发布前核验。"
  canonicalPath="/outbound-compliance"
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '企业出海与原产地合规' }]} />
  </div>

  <section class="page-head">
    <div class="container">
      <p class="eyebrow">栏目</p>
      <h1>企业出海与原产地合规</h1>
      <p class="lead">
        面向将制造环节迁往东南亚、或面对美国关税与贸易救济措施的出口制造企业，
        聚焦原产地认定、关税风险与证据留存。
      </p>
    </div>
  </section>

  <section class="section section--plain">
    <div class="container">
      <h2 class="section__title">本栏目关注的核心问题</h2>
      <ul class="clean-list">
        <li>供应链搬到东南亚，能否以新原产地合规申报美国进口？</li>
        <li>美国「实质性改变」标准如何适用，哪些加工只算简单加工？</li>
        <li>Section 301、Section 232、AD/CVD 与反规避措施的适用边界。</li>
        <li>企业应留存哪些证据链，以应对海关或客户核查。</li>
      </ul>

      <h2 class="section__title" style="margin-top:48px;">本栏目文章</h2>
      <div class="dir-list">
        {
          view.map((a) => (
            <a class="dir-item" href={`/articles/${a.slug}`}>
              <span class="dir-item__col">{a.col}</span>
              <span class="dir-item__title">{a.title}</span>
              <span class="dir-item__summary">{a.summary}</span>
              <span class="dir-item__meta">更新于 {a.updated}</span>
              <span class="dir-item__arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
        {view.length === 0 && <p class="section__lead">本栏目文章整理中，敬请期待。</p>}
      </div>

      <div class="disclaimer-box" role="note" style="margin-top:36px;">
        <strong>提示：</strong>
        本栏目内容仅作一般性专业信息分享，不构成法律、海关或贸易意见，亦不承诺任何结果。
        美国关税与贸易措施以官方最新来源与个案事实为准。
      </div>
    </div>
  </section>
</BaseLayout>
