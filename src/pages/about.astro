---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { personJsonLd } from '../lib/seo';
import siteConfig from '../site.config';
import { columnOf } from '../lib/columns';

const d = siteConfig.display;
const a = siteConfig.author;
const articles = (await getCollection('articles')).sort((x, y) =>
  y.data.datePublished.localeCompare(x.data.datePublished)
);
const personLd = personJsonLd();
const hasEmail = Boolean(a.email);

function summaryOf(body: string): string {
  return body.match(/^>\s*摘要[：:]\s*(.+)$/m)?.[1]?.trim() ?? '';
}
const articlesView = articles.map((x) => ({
  slug: x.slug,
  title: x.data.title,
  col: columnOf(x.data.category).label,
  updated: x.data.updatedAsOf,
  summary: summaryOf(x.body),
}));
const recentArticles = articlesView.slice(0, 3);
---

<BaseLayout
  title="关于江恒"
  description={d.aboutDescription}
  canonicalPath="/about"
  jsonLd={personLd ? [personLd] : []}
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '关于江恒' }]} />
  </div>

  <section class="about-hero">
    <div class="container">
      <div class="about-hero__grid">
        <figure class="about-hero__photo">
          <img src="/images/portrait.png" alt="江恒律师职业照" width="413" height="619" loading="eager" />
          <figcaption>江恒律师 · {a.lawFirm}</figcaption>
        </figure>
        <div class="about-hero__body">
          <p class="hero__eyebrow">ATTORNEY PROFILE</p>
          <h1>江恒律师</h1>
          <p class="about-hero__role">{d.jobTitle}</p>
          <p class="about-hero__lead">以金融与法律的复合视角，处理跨境税务、企业出海合规与跨境资金账户相关议题。</p>
          <dl class="profile-facts">
            <div><dt>金融经历</dt><dd>7 年</dd></div>
            <div><dt>法律实务</dt><dd>5 年</dd></div>
            <div><dt>执业机构</dt><dd>{a.lawFirm}</dd></div>
          </dl>
          <a class="btn btn--primary" href="/contact">联系咨询 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--plain">
    <div class="container about-story">
      <div class="section-heading">
        <div>
          <p class="section-index">01 / PROFESSIONAL PATH</p>
          <h2 class="section__title">从金融现场，到法律判断</h2>
        </div>
      </div>
      <div class="about-story__grid">
        <div class="about-story__intro">
          <p>{d.bio}</p>
          <p>处理跨境问题时，规则本身只是起点。企业的组织结构、交易安排、资金流、货物流、合同与单证之间能否相互印证，往往决定了风险判断是否经得起核验。</p>
        </div>
        <ol class="career-timeline">
          <li><span>01</span><div><h3>国有银行</h3><p>5 年金融从业经历，形成对账户、资金、授信与合规流程的理解。</p></div></li>
          <li><span>02</span><div><h3>上市供应链企业</h3><p>2 年企业经历，理解跨部门协作、业务流与供应链场景中的现实约束。</p></div></li>
          <li><span>03</span><div><h3>法律实务</h3><p>5 年法律实践，聚焦跨境税务、企业出海合规与跨境资金账户相关问题。</p></div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">02 / FOCUS</p>
          <h2 class="section__title">专业关注领域</h2>
          <p class="section__lead">围绕企业跨境经营中最容易出现信息断点和规则错配的环节展开。</p>
        </div>
      </div>
      <div class="focus-grid">
        {d.focuses.map((f, i) => <div><span>{String(i + 1).padStart(2, '0')}</span><p>{f}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">03 / WRITING</p>
          <h2 class="section__title">近期观点与文章</h2>
          <p class="section__lead">基于公开规则和官方来源撰写，供理解问题结构与风险框架之用。</p>
        </div>
        <a class="text-link" href="/articles">进入文章中心 <span aria-hidden="true">→</span></a>
      </div>
      <div class="about-articles">
        {recentArticles.map((x) => (
          <a href={`/articles/${x.slug}`}>
            <span>{x.col}</span><h3>{x.title}</h3><p>{x.summary}</p><b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="navy-block">
        <div>
          <p class="navy-block__eyebrow">PUBLIC CONTACT</p>
          <h2>执业机构与联系</h2>
          <p>执业机构：{a.lawFirm}</p>
        </div>
        {hasEmail && <div class="navy-block__action"><a class="btn btn--light" href={`mailto:${a.email}?subject=跨境合规初步咨询`}>发送邮件 <span aria-hidden="true">→</span></a><p class="navy-block__action-meta">{a.email}</p></div>}
        <p class="navy-block__note">本站内容仅为一般信息，不构成法律、税务、外汇、海关或投资意见，亦不构成委托代理关系。</p>
      </div>
    </div>
  </section>
</BaseLayout>
