---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { columnOf } from '../../lib/columns';

const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.datePublished.localeCompare(a.data.datePublished)
);

function summaryOf(body: string): string {
  return body.match(/^>\s*摘要[：:]\s*(.+)$/m)?.[1]?.trim() ?? '';
}
const view = articles.map((a) => ({
  slug: a.slug,
  title: a.data.title,
  col: columnOf(a.data.category).label,
  updated: a.data.updatedAsOf,
  summary: summaryOf(a.body),
}));
---

<BaseLayout
  title="文章中心"
  description="江恒律师关于跨境资金、数字人民币、银行合规、制裁、跨境税务与企业出海交易的专业文章，基于官方来源撰写并经发布前核验。"
  canonicalPath="/articles"
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '文章中心' }]} />
  </div>

  <section class="page-head">
    <div class="container">
      <p class="eyebrow">专业文章</p>
      <h1>文章中心</h1>
      <p class="lead">以“钱如何跨越账户、国境与法律体系”为母命题，从支付、账户、制裁、税务、数据与交易证据拆解企业问题。</p>
    </div>
  </section>

  <section class="section section--plain">
    <div class="container">
      <a class="series-strip series-strip--primary" href="/articles/money-legal-identity">
        <span class="series-strip__kicker">母栏目 · 跨境资金法律观察</span>
        <span class="series-strip__title">钱的法律身份</span>
        <span class="series-strip__desc">从资金来源、支付通道、账户控制、合规信息、税务归属和争议救济，理解一笔钱进入不同法律体系后的权利结构。</span>
        <span class="series-strip__arrow" aria-hidden="true">→</span>
      </a>
      <a class="series-strip" href="/articles/digital-renminbi">
        <span class="series-strip__kicker">系列 · 数字人民币法律观察</span>
        <span class="series-strip__title">数字人民币与企业交易</span>
        <span class="series-strip__desc">从钱包负债、支付效果、智能合约、资金归属和跨境合规协议，讨论新型货币基础设施进入企业交易后的法律问题。</span>
        <span class="series-strip__arrow" aria-hidden="true">→</span>
      </a>
      <a class="series-strip series-strip--notes" href="/notes">
        <span class="series-strip__kicker">短文 · 工作笔记</span>
        <span class="series-strip__title">先把问题拆开</span>
        <span class="series-strip__desc">围绕资金、账户、供应链与跨境税务中的常见起点，记录短而可核验的思考线索。</span>
        <span class="series-strip__arrow" aria-hidden="true">→</span>
      </a>
      <div class="dir-list">
        {
          view.map((a) => (
            <a class="dir-item" href={`/articles/${a.slug}`}>
              <span class="dir-item__col">{a.col}</span>
              <span class="dir-item__title">{a.title}</span>
              <span class="dir-item__summary">{a.summary}</span>
              <span class="dir-item__meta">更新于 {a.updated}</span>
              <span class="dir-item__arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
