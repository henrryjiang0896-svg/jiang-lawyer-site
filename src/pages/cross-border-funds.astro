---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { columnOf } from '../lib/columns';

const CATEGORY = '跨境资金与账户合规';
const articles = (await getCollection('articles'))
  .filter((a) => a.data.category === CATEGORY)
  .sort((a, b) => b.data.datePublished.localeCompare(a.data.datePublished));

function summaryOf(body: string): string {
  return body.match(/^>\s*摘要[：:]\s*(.+)$/m)?.[1]?.trim() ?? '';
}
const view = articles.map((a) => ({
  slug: a.slug,
  title: a.data.title,
  col: columnOf(a.data.category).label,
  updated: a.data.updatedAsOf,
  summary: summaryOf(a.body),
}));
---

<BaseLayout
  title="跨境资金与账户合规"
  description="江恒律师关于对公账户受限/冻结、跨境电商收款税务合规、跨境资金与银行尽调的文章与观点，基于中国官方来源并经发布前核验。"
  canonicalPath="/cross-border-funds"
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '跨境资金与账户合规' }]} />
  </div>

  <section class="page-head">
    <div class="container">
      <p class="eyebrow">栏目</p>
      <h1>跨境资金与账户合规</h1>
      <p class="lead">
        面向企业财务负责人、跨境电商经营者与有跨境资金往来需求的主体，
        聚焦银行账户合规、跨境收款税务一致性与银行尽调逻辑。
      </p>
    </div>
  </section>

  <section class="section section--plain">
    <div class="container">
      <h2 class="section__title">本栏目关注的核心问题</h2>
      <ul class="clean-list">
        <li>对公账户被限制或冻结，应如何区分银行风控、法院与涉案冻结？</li>
        <li>跨境电商如何选择与主体、业务相匹配的合法收款路径？</li>
        <li>主体、资金、货物、单证、申报如何保持一致以降低合规风险？</li>
        <li>银行客户尽调（KYC）与可疑交易报告的基本逻辑。</li>
      </ul>

      <h2 class="section__title" style="margin-top:48px;">本栏目文章</h2>
      <div class="dir-list">
        {
          view.map((a) => (
            <a class="dir-item" href={`/articles/${a.slug}`}>
              <span class="dir-item__col">{a.col}</span>
              <span>
                <span class="dir-item__title">{a.title}</span>
                <span class="dir-item__summary">{a.summary}</span>
              </span>
              <span class="dir-item__meta">更新于 {a.updated}</span>
              <span class="dir-item__arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
        {view.length === 0 && <p class="section__lead">本栏目文章整理中，敬请期待。</p>}
      </div>

      <div class="disclaimer-box" role="note" style="margin-top:36px;">
        <strong>提示：</strong>
        本栏目内容仅作一般性专业信息分享，不构成法律、银行、外汇或税务意见，亦不承诺任何结果。
        具体事项应结合事实与发布时有效规则，由具备资质的专业人士判断。
      </div>
    </div>
  </section>
</BaseLayout>
