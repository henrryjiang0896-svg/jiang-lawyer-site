---
import ContactCTA from '../components/ContactCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import siteConfig from '../site.config';

const d = siteConfig.display;
---

<BaseLayout
  title="服务与能力"
  description="江恒律师可提供的跨境资金、数字人民币、银行尽调与账户风险、跨境税务和供应链交易专业支持，以及工作成果与交付边界说明。"
  canonicalPath="/services"
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '服务与能力' }]} />
  </div>

  <section class="page-head service-head">
    <div class="container">
      <p class="eyebrow">专业能力</p>
      <h1>服务与能力</h1>
      <p class="lead">
        围绕一笔资金的交易背景、支付通道、账户控制、合规信息、税务归属与争议证据提供专业支持。
        以下列明的是可识别的工作成果，不是对账户恢复、税务处理或案件结果的承诺。
      </p>
    </div>
  </section>

  <section class="section section--plain">
    <div class="container">
      <div class="service-grid">
        {
          d.services.map((s, i) => (
            <div class="service-card" id={`service-${i + 1}`}>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <p><strong>适用情形：</strong>{s.scenario}</p>
              <p><strong>主要成果：</strong>{s.outcome}具体范围与形式以委托约定为准。</p>
              <a class="text-link" href={s.href}>查看相关说明 →</a>
            </div>
          ))
        }
      </div>

      <div class="service-feature">
        <div><div class="card__kicker">专项评估服务</div>
        <h3>东盟供应链迁移与原产地合规评估</h3>
        <p>
          面向将生产或采购向东南亚迁移、并需评估美国原产地规则、关税与贸易救济风险的企业。
          查看服务说明、适用对象、评估步骤与初步沟通方式。
        </p></div>
        <a class="btn btn--ghost" href="/asean-supply-chain-compliance">查看专项评估服务 <span aria-hidden="true">→</span></a>
      </div>

      <div class="download-strip">
        <div><p class="section-index">FREE CHECKLIST</p><h3>企业出海前：跨境资金与税务核查清单</h3><p>一份用于内部问题整理的可打印清单，覆盖主体、单证、资金、税务与供应链五个基础核查维度。</p></div>
        <a class="btn btn--primary" href="/downloads/企业出海前-跨境资金与税务核查清单.pdf" download>下载 PDF <span aria-hidden="true">↓</span></a>
      </div>

      <div class="service-process">
        <div><p class="section-index">WORKFLOW</p><h2>典型工作方式</h2></div>
        <ol><li><b>01</b><span><strong>绘制路径</strong>识别主体、交易、货币、账户、支付节点与资金控制关系。</span></li><li><b>02</b><span><strong>匹配规则</strong>核对银行、支付、外汇、制裁、税务、数据与贸易规则。</span></li><li><b>03</b><span><strong>重组证据</strong>检查合同、流水、物流、发票、账务与申报是否相互印证。</span></li><li><b>04</b><span><strong>形成交付</strong>输出结构图、问题矩阵、材料缺口与可讨论的改进或救济路径。</span></li></ol>
      </div>

      <ContactCTA title="了解适合你的服务与费用安排" body="先概括问题、涉及地区和期限，再确认是否适合承接及具体服务安排。" />
      <h2 class="section__title" style="margin-top:48px;">交付边界与免责</h2>
      <div class="disclaimer-box" role="note">
        <strong>重要边界：</strong>
        本站所述服务为「专业支持方向」描述，不承诺任何账户恢复、税款结果、关税待遇或案件结论。
        涉及具体事项的判断，应结合主体、商品、监管模式、合同、资金与单证等事实，并依据发布时有效的法律法规与官方规则，由具备资质的专业人士作出。
        本网站内容不构成法律、税务、外汇、海关或投资意见，也不构成委托代理关系。
      </div>
    </div>
  </section>
</BaseLayout>
