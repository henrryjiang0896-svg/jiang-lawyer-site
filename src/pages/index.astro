---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { websiteJsonLd, personJsonLd, legalServiceJsonLd } from '../lib/seo';
import siteConfig from '../site.config';
import { columnOf } from '../lib/columns';

const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.datePublished.localeCompare(a.data.datePublished)
);

const d = siteConfig.display;
const columns = siteConfig.columns;
const personLd = personJsonLd();
const jsonLdArr = [
  websiteJsonLd(),
  ...(personLd ? [personLd] : []),
  legalServiceJsonLd(),
];

// 文章短摘要（取正文「> 摘要：」行）
function summaryOf(body: string): string {
  return body.match(/^>\s*摘要[：:]\s*(.+)$/m)?.[1]?.trim() ?? '';
}

const articlesView = articles.map((a) => ({
  slug: a.slug,
  title: a.data.title,
  col: columnOf(a.data.category).label,
  updated: a.data.updatedAsOf,
  summary: summaryOf(a.body),
}));
const featuredArticles = articlesView.slice(0, 4);
const latestArticles = articlesView.slice(0, 5);
---

<BaseLayout
  title={d.tagline}
  description={d.subtitle}
  jsonLd={jsonLdArr}
>
  <!-- 首屏：个人品牌与专业方向 -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">{d.penName} · Attorney at Law</p>
        <h1>跨境税务与出海合规律师</h1>
        <p class="hero__sub">{d.subtitle}</p>
        <p class="hero__identity">
          {siteConfig.author.lawFirm}｜7 年金融从业经验（5 年国有银行、2 年上市供应链企业）及 5 年法律实践经验。
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact">联系江恒律师</a>
          <a class="btn btn--ghost" href="/articles">阅读专业文章</a>
        </div>
      </div>
      <aside class="hero__aside" aria-label="职业照与专业方向">
        <figure class="hero__photo">
          <img
            src="/images/portrait.png"
            alt="江恒律师职业照"
            class="hero__photo-img"
            width="413"
            height="619"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>江恒律师 · 上海曼昆（深圳）律师事务所</figcaption>
        </figure>
        <div class="hero__module">
          <p class="hero__module-title">专业服务方向</p>
          <ul>
            {
              columns.map((c) => (
                <li>
                  <a href={c.href}>
                    <span>{c.label}</span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- 我关注的问题 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">01 / INSIGHTS</p>
          <h2 class="section__title">我关注的问题</h2>
          <p class="section__lead">从业务情境出发，提供可被核验的合规分析。</p>
        </div>
        <a class="text-link" href="/articles">查看全部文章 <span aria-hidden="true">→</span></a>
      </div>
      <div class="q-list">
        {
          featuredArticles.map((a, i) => (
            <div class="q-item">
              <span class="q-item__no">{String(i + 1).padStart(2, '0')}</span>
              <a href={`/articles/${a.slug}`}>{a.title}</a>
              <span class="arrow" aria-hidden="true">→</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 专业背景 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">02 / BACKGROUND</p>
          <h2 class="section__title">金融与法律的复合经历</h2>
          <p class="section__lead">以金融底色理解风险，以律师视角提供可落地方案。</p>
        </div>
      </div>
      <div class="stats">
        <div class="stat">
          <div class="stat__num">7<small> 年</small></div>
          <div class="stat__label">金融从业经验</div>
        </div>
        <div class="stat">
          <div class="stat__num">5<small> 年</small></div>
          <div class="stat__label">国有银行</div>
        </div>
        <div class="stat">
          <div class="stat__num">2<small> 年</small></div>
          <div class="stat__label">上市供应链企业</div>
        </div>
        <div class="stat">
          <div class="stat__num">5<small> 年</small></div>
          <div class="stat__label">法律实务经验</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 服务与能力 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">03 / CAPABILITIES</p>
          <h2 class="section__title">服务与能力</h2>
          <p class="section__lead">
            以下为可提供的专业支持方向，不构成结果承诺；具体范围以正式委托与事实评估为准。
          </p>
        </div>
        <a class="text-link" href="/services">了解服务边界 <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid-2 svc-list">
        {
          d.services.map((s) => (
            <div class="svc">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">04 / PUBLICATIONS</p>
          <h2 class="section__title">最新文章</h2>
          <p class="section__lead">基于官方来源撰写，并经发布前准确性核验。</p>
        </div>
        <a class="text-link" href="/articles">文章中心 <span aria-hidden="true">→</span></a>
      </div>
      <div class="dir-list">
        {
          latestArticles.map((a) => (
            <a class="dir-item" href={`/articles/${a.slug}`}>
              <span class="dir-item__col">{a.col}</span>
              <span>
                <span class="dir-item__title">{a.title}</span>
                <span class="dir-item__summary">{a.summary}</span>
              </span>
              <span class="dir-item__meta">更新于 {a.updated}</span>
              <span class="dir-item__arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 联系咨询 -->
  <section class="section">
    <div class="container">
      <div class="navy-block">
        <div>
          <p class="navy-block__eyebrow">INITIAL CONSULTATION</p>
          <h2>让问题先回到事实与规则</h2>
          <p>
            如您正在处理跨境税务、出海合规、账户受限或境外架构相关问题，
            可就具体问题联系江恒律师做初步评估。
          </p>
        </div>
        <div class="navy-block__action">
          <a class="btn btn--light" href="/contact">联系咨询 <span aria-hidden="true">→</span></a>
        </div>
        <p class="navy-block__note">
          提交咨询不构成委托关系，请勿发送保密材料或敏感信息（如账户号码、身份证件、合同条款）。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
