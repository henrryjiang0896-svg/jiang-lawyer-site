---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { websiteJsonLd, personJsonLd, legalServiceJsonLd } from '../lib/seo';
import siteConfig from '../site.config';
import { columnOf } from '../lib/columns';

const articles = (await getCollection('articles')).sort((a, b) =>
  b.data.datePublished.localeCompare(a.data.datePublished)
);

const d = siteConfig.display;
const columns = siteConfig.columns;
const personLd = personJsonLd();
const jsonLdArr = [
  websiteJsonLd(),
  ...(personLd ? [personLd] : []),
  legalServiceJsonLd(),
];

// 文章短摘要（取正文「> 摘要：」行）
function summaryOf(body: string): string {
  return body.match(/^>\s*摘要[：:]\s*(.+)$/m)?.[1]?.trim() ?? '';
}

const articlesView = articles.map((a) => ({
  slug: a.slug,
  title: a.data.title,
  col: columnOf(a.data.category).label,
  updated: a.data.updatedAsOf,
  summary: summaryOf(a.body),
}));
const latestArticles = articlesView.slice(0, 5);
const leadArticle = latestArticles[0];
const supportingArticles = latestArticles.slice(1, 4);
const frameworkLayers = [
  ['01', '交易', '这笔钱为什么支付，基础交易是否真实、完整并可解释。'],
  ['02', '主体', '谁签约、履约、付款、收款，实际控制人与受益所有人是谁。'],
  ['03', '货币', '使用什么计价、支付和持有，汇率与资产风险由谁承担。'],
  ['04', '通道', '资金经过哪些银行、钱包、清算机构或链上节点。'],
  ['05', '控制', '谁能拒绝、冻结、退回、分账或改变资金用途。'],
  ['06', '合规', 'KYC、反洗钱、制裁与交易真实性义务如何分配。'],
  ['07', '税务与数据', '资金性质、申报义务及随交易跨境流动的信息。'],
  ['08', '证据与救济', '发生限制、误付或争议时，如何证明、申诉与追索。'],
];
const questionEntrances = [
  {
    question: '供应链迁至东盟后，原产地与申报信息应先核对什么？',
    context: '适用于生产、组装或采购布局调整后，准备进入美国市场或回应海外客户问询的情境。',
    href: '/asean-supply-chain-compliance',
  },
  {
    question: '企业资金与个人资金混用时，应从哪些事实开始梳理？',
    context: '先区分主体、账户、交易背景与留存材料，再讨论可能的风险和处理路径。',
    href: '/cross-border-funds',
  },
  {
    question: '境外账户信息交换后，哪些信息需要优先核验？',
    context: '适用于需要理解申报、税务居民身份、账户信息与证据留存之间关系的情境。',
    href: '/tax-crs',
  },
  {
    question: '收到银行限制或账户冻结通知后，应先保留哪些材料？',
    context: '先固定通知、交易背景和沟通记录，避免在事实尚未厘清时作出不一致表述。',
    href: '/articles/corporate-bank-account-restricted-or-frozen',
  },
];
---

<BaseLayout
  title={d.tagline}
  description={d.subtitle}
  jsonLd={jsonLdArr}
>
  <!-- 首屏：个人品牌与专业方向 -->
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__eyebrow">{d.penName} · Attorney at Law</p>
        <h1>跨境资金、数字人民币<br />与出海合规律师</h1>
        <p class="hero__sub">{d.subtitle}</p>
        <p class="hero__thesis">我关注的不只是钱能否跨境移动，而是它进入了谁的规则、携带了什么信息、由谁控制，以及发生争议后如何追索。</p>
        <p class="hero__identity">
          {siteConfig.author.lawFirm}｜7 年金融从业经验（5 年国有银行、2 年上市供应链企业）及 5 年法律实践经验。
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/contact">联系咨询</a>
          <a class="btn btn--ghost" href="/services">了解服务与流程</a>
        </div>
      </div>
      <aside class="hero__aside" aria-label="职业照与专业方向">
        <figure class="hero__photo">
          <img
            src="/images/portrait.png"
            alt="江恒律师职业照"
            class="hero__photo-img"
            width="413"
            height="619"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>江恒律师 · 上海曼昆（深圳）律师事务所</figcaption>
        </figure>
        <div class="hero__module">
          <p class="hero__module-title">专业服务方向</p>
          <ul>
            {
              columns.map((c) => (
                <li>
                  <a href={c.href}>
                    <span>{c.label}</span>
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- 核心方法：跨境资金八层审查 -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">01 / CROSS-BORDER FUNDS MODEL</p>
          <h2 class="section__title">跨境资金八层审查模型</h2>
          <p class="section__lead">一笔钱跨越账户、国境或货币体系时，应当同时审查交易事实、支付基础设施、合规信息与争议救济。</p>
        </div>
        <a class="text-link" href="/articles/money-legal-identity">进入“钱的法律身份” <span aria-hidden="true">→</span></a>
      </div>
      <div class="framework-grid">
        {frameworkLayers.map(([no, title, desc]) => (
          <article class="framework-card"><span>{no}</span><h3>{title}</h3><p>{desc}</p></article>
        ))}
      </div>
      <div class="thesis-strip">
        <p>强大，使别人不得不进入你的规则；可信，使别人愿意把钱和未来留在你的规则里。</p>
        <a href="/articles/money-enters-currency-enters-rules">阅读总纲文章 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 问题入口 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">02 / START WITH A QUESTION</p>
          <h2 class="section__title">先从你正在处理的问题开始</h2>
          <p class="section__lead">不急于给出结论。先判断关键事实、需要核验的规则和应当留存的材料。</p>
        </div>
        <a class="text-link" href="/services">查看服务方向 <span aria-hidden="true">→</span></a>
      </div>
      <div class="q-list">
        {
          questionEntrances.map((item, i) => (
            <a class="q-item q-item--entry" href={item.href}>
              <span class="q-item__no">{String(i + 1).padStart(2, '0')}</span>
              <span class="q-item__body"><strong>{item.question}</strong><small>{item.context}</small></span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 专业背景 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">03 / BACKGROUND</p>
          <h2 class="section__title">金融与法律的复合经历</h2>
          <p class="section__lead">以金融底色理解风险，以律师视角提供可落地方案。</p>
        </div>
      </div>
      <div class="stats">
        <div class="stat">
          <div class="stat__num">7<small> 年</small></div>
          <div class="stat__label">金融从业经验</div>
        </div>
        <div class="stat">
          <div class="stat__num">5<small> 年</small></div>
          <div class="stat__label">国有银行</div>
        </div>
        <div class="stat">
          <div class="stat__num">2<small> 年</small></div>
          <div class="stat__label">上市供应链企业</div>
        </div>
        <div class="stat">
          <div class="stat__num">5<small> 年</small></div>
          <div class="stat__label">法律实务经验</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 服务与能力 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">04 / CAPABILITIES</p>
          <h2 class="section__title">服务与能力</h2>
          <p class="section__lead">
            以下为可提供的专业支持方向，不构成结果承诺；具体范围以正式委托与事实评估为准。
          </p>
        </div>
        <a class="text-link" href="/services">了解服务边界 <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid-2 svc-list">
        {
          d.services.map((s) => (
            <div class="svc">
              <h3><a href={s.href}>{s.title}</a></h3>
              <p>{s.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section section--tint">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">05 / APPROACH</p>
          <h2 class="section__title">从事实到判断的工作方式</h2>
          <p class="section__lead">先厘清事实、规则与证据，再讨论可行路径与边界。</p>
        </div>
      </div>
      <div class="method-grid">
        <div class="method-step"><span>01</span><h3>厘清事实</h3><p>梳理主体、业务、资金、货物、合同与单证等关键连接点。</p></div>
        <div class="method-step"><span>02</span><h3>识别规则</h3><p>判断可能适用的税务、外汇、海关、贸易与账户合规要求。</p></div>
        <div class="method-step"><span>03</span><h3>校验证据</h3><p>检视事实陈述、交易文件与申报信息之间是否形成闭环。</p></div>
        <div class="method-step"><span>04</span><h3>明确边界</h3><p>说明风险优先级、可讨论路径与需要引入的其他专业支持。</p></div>
      </div>
      <div class="scenario-card">
        <div class="scenario-card__label">COMMON SCENARIO · 非客户案例</div>
        <div>
          <h3>供应链迁移后，原产地与申报信息如何保持一致？</h3>
          <p>当企业计划将部分采购或生产安排至东南亚并面向美国市场销售时，通常需要先确认主体分工、加工环节、货物流、合同与单证的对应关系，再评估原产地判断与申报信息的一致性。</p>
        </div>
        <a class="text-link" href="/asean-supply-chain-compliance">查看专项评估说明 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 最新文章 -->
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="section-index">06 / PUBLICATIONS</p>
          <h2 class="section__title">最新文章</h2>
          <p class="section__lead">基于官方来源撰写，并经发布前准确性核验。</p>
        </div>
        <a class="text-link" href="/articles">文章中心 <span aria-hidden="true">→</span></a>
      </div>
      {
        leadArticle && (
          <div class="publication-layout">
            <a class="lead-article" href={`/articles/${leadArticle.slug}`}>
              <span class="lead-article__index">LATEST NOTE</span>
              <span class="lead-article__category">{leadArticle.col}</span>
              <h3>{leadArticle.title}</h3>
              <p>{leadArticle.summary}</p>
              <span class="lead-article__link">阅读文章 <span aria-hidden="true">→</span></span>
            </a>
            <div class="supporting-articles">
              {
                supportingArticles.map((a) => (
                  <a class="supporting-article" href={`/articles/${a.slug}`}>
                    <span>{a.col}</span>
                    <h3>{a.title}</h3>
                    <p>更新于 {a.updated}</p>
                    <b aria-hidden="true">→</b>
                  </a>
                ))
              }
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- 联系咨询 -->
  <section class="section">
    <div class="container">
      <div class="navy-block">
        <div>
          <p class="navy-block__eyebrow">INITIAL CONSULTATION</p>
          <h2>就你的具体问题联系咨询</h2>
          <p>
            如您正在处理跨境资金、数字人民币、银行尽调、制裁、税务或出海交易问题，
            可就具体问题联系江恒律师做初步评估。
          </p>
        </div>
        <div class="navy-block__action">
          <a class="btn btn--light" href="/contact">联系咨询 <span aria-hidden="true">→</span></a>
          <p class="navy-block__action-meta">先说明问题 · 再确认安排与费用</p>
        </div>
        <p class="navy-block__note">
          提交咨询不构成委托关系，请勿发送保密材料或敏感信息（如账户号码、身份证件、合同条款）。
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
