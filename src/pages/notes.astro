---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const notes = [
  {
    no: '01',
    title: '一笔资金难以解释时，先问“它对应什么业务”',
    body: '先把付款方、收款方、交易背景、合同或订单、货物或服务及现有凭证放在同一条线上看。金额本身通常不能替代商业事实。',
    href: '/cross-border-funds',
  },
  {
    no: '02',
    title: '账户受限时，第一件事不是“找替代账户”',
    body: '先保留通知、交易记录、沟通经过和账户用途说明。越早固定事实，越能避免后续出现不一致的解释。',
    href: '/articles/corporate-bank-account-restricted-or-frozen',
  },
  {
    no: '03',
    title: '供应链迁移不等于原产地当然发生变化',
    body: '国家标签只是起点。判断仍需回到产品、关键工序、加工深度与可留存记录，而不是仅看最终组装地。',
    href: '/asean-supply-chain-compliance',
  },
  {
    no: '04',
    title: '面对境外账户问题，先区分事实、身份与申报',
    body: '账户存在、税收居民身份、资金来源与申报义务是不同层次的问题。先拆开，才知道哪些材料和规则真正相关。',
    href: '/tax-crs',
  },
];
---

<BaseLayout
  title="工作笔记"
  description="江恒律师围绕跨境资金、账户、供应链与税务合规整理的简短工作笔记：先厘清事实，再判断规则与证据。"
  canonicalPath="/notes"
>
  <div class="container">
    <Breadcrumb items={[{ label: '首页', href: '/' }, { label: '文章中心', href: '/articles' }, { label: '工作笔记' }]} />
  </div>

  <section class="page-head">
    <div class="container">
      <p class="eyebrow">WORKING NOTES</p>
      <h1>工作笔记</h1>
      <p class="lead">每则笔记只处理一个起点：先把问题拆开，再决定应当核对哪些事实、规则和材料。</p>
    </div>
  </section>

  <section class="section section--plain">
    <div class="container">
      <div class="notes-intro">
        <p>这些短文用于帮助读者识别问题，不替代针对具体事实的法律、税务、银行或贸易意见。</p>
        <a class="text-link" href="/contact">需要讨论具体情形 <span aria-hidden="true">→</span></a>
      </div>
      <div class="notes-grid">
        {
          notes.map((note) => (
            <a class="note-card" href={note.href}>
              <span>{note.no}</span>
              <h2>{note.title}</h2>
              <p>{note.body}</p>
              <b>延伸阅读 <i aria-hidden="true">→</i></b>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
